{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "content": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "omb-partition-artifact/v3.1"
        },
        "dataset_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "antecedent_public_contract_hash": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "partitions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "unit_level": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "seed_provenance": {
                "type": "object",
                "properties": {
                  "method": {
                    "const": "hmac-sha256"
                  },
                  "producer_id": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                  },
                  "key_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "contract_hash": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "seed_commitment": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "method",
                  "producer_id",
                  "key_id",
                  "contract_hash",
                  "seed_commitment"
                ],
                "additionalProperties": false
              },
              "units": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "node": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                    },
                    "identity_scope": {
                      "type": "string",
                      "minLength": 1
                    },
                    "identity_key": {
                      "type": "string",
                      "minLength": 1
                    },
                    "allocation": {
                      "type": "string",
                      "enum": [
                        "dev",
                        "held-out",
                        "excluded"
                      ]
                    },
                    "burn": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "status": {
                              "const": "unseen"
                            }
                          },
                          "required": [
                            "status"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "status": {
                              "const": "burned"
                            },
                            "look_record_hashes": {
                              "type": "array",
                              "items": {
                                "type": "string",
                                "minLength": 1,
                                "pattern": "^[0-9a-f]{64}$"
                              },
                              "minItems": 1,
                              "uniqueItems": true
                            }
                          },
                          "required": [
                            "status",
                            "look_record_hashes"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "node",
                    "identity_scope",
                    "identity_key",
                    "allocation",
                    "burn"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "uniqueItems": false
              }
            },
            "required": [
              "id",
              "unit_level",
              "seed_provenance",
              "units"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "producers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "task-author",
                  "curator",
                  "owner",
                  "stager",
                  "software"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "model_family": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source_bundle_hash": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9a-f]{64}$"
              },
              "outcome_blind": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "kind",
              "name",
              "version",
              "model_family",
              "source_bundle_hash",
              "outcome_blind"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pointer": {
                "type": "string",
                "minLength": 1,
                "pattern": "^/"
              },
              "status": {
                "type": "string",
                "enum": [
                  "author",
                  "cited",
                  "assumed",
                  "contested"
                ]
              },
              "producer_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "file_sha256": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[0-9a-f]{64}$"
                    },
                    "byte_start": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "byte_end": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "file_sha256",
                    "byte_start",
                    "byte_end",
                    "quote"
                  ],
                  "additionalProperties": false
                },
                "minItems": 0,
                "uniqueItems": false
              },
              "note": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "pointer",
              "status",
              "producer_ids",
              "citations",
              "note"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "uniqueItems": false
        }
      },
      "required": [
        "schema_version",
        "dataset_id",
        "antecedent_public_contract_hash",
        "partitions",
        "producers",
        "evidence"
      ],
      "additionalProperties": false
    },
    "hash": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "content",
    "hash"
  ],
  "additionalProperties": false
}
