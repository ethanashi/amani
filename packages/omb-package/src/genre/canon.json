    "^(\\d+\\.?\\s*)?((materials? and )?methods?|methodology|patients and methods|study design|online methods|star\\W*methods|experimental procedures|methods and materials)\\b"
  ],
  [
    "results",
    "^(\\d+\\.?\\s*)?(results?|findings)\\b"
  ],
  [
    "results_discussion",
    "^(\\d+\\.?\\s*)?results and discussion\\b"
  ],
  [
    "discussion",
    "^(\\d+\\.?\\s*)?(discussion|comment|interpretation)\\b"
  ],
  [
    "limitations",
    "^(\\d+\\.?\\s*)?(limitations?|strengths and limitations|study limitations)\\b"
  ],
  [
    "conclusions",
    "^(\\d+\\.?\\s*)?(conclusions?|concluding remarks|summary and conclusions?)\\b"
  ],
  [
    "data_availability",
    "(data|code|software|materials?)( and (code|data|materials?|software))? (availability|sharing|access)|availability of (data|code)|data statement|resource availability"
  ],
  [
    "acknowledgements",
    "^acknowledg"
  ],
  [
    "funding",
    "^(funding|financial support|role of the funder|grant)"
  ],
  [
