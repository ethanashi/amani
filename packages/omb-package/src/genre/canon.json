    "(competing|conflicts?|declaration) of interests?|competing interests|disclosures?|conflict"
  ],
  [
    "ethics",
    "ethic|consent|institutional review"
  ],
  [
    "declarations",
    "^declarations?$"
  ],
  [
    "references",
    "^references?$|^bibliography"
  ],
  [
    "supplementary",
    "supplement|associated data|additional (files|information)|appendix"
  ],
  [
    "transparency",
    "transparency|patient and public|dissemination|provenance|what is already known|what this study adds|summary box"
