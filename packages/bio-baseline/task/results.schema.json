{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Warm-up results.json (TASK.md)",
  "description": "Exactly the keys in TASK.md's results.json block; anything else belongs under extra. Checked by Omerta Bio software after every frozen execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["n_patients_analyzed", "n_events", "score_method", "proliferation_metagene", "random_signatures", "published_signatures", "negative_control", "conclusion"],
  "properties": {
    "n_patients_analyzed": { "type": "integer" },
    "n_events": { "type": "integer" },
    "score_method": { "type": "string" },
    "proliferation_metagene": {
      "type": "object",
      "required": ["definition", "n_genes"],
      "properties": { "definition": { "type": "string" }, "n_genes": { "type": "integer" } }
    },
    "random_signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["size", "draws", "share_p_lt_0_05_unadjusted", "share_p_lt_0_05_adjusted"],
        "properties": {
          "size": { "type": "integer" },
          "draws": { "type": "integer" },
          "share_p_lt_0_05_unadjusted": { "type": "number" },
          "share_p_lt_0_05_adjusted": { "type": "number" }
        }
      }
    },
    "published_signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "n_genes_used", "p_unadjusted", "p_adjusted", "share_random_same_size_with_smaller_or_equal_p"],
        "properties": {
          "name": { "type": "string" },
          "n_genes_used": { "type": "integer" },
          "p_unadjusted": { "type": "number" },
          "p_adjusted": { "type": "number" },
          "share_random_same_size_with_smaller_or_equal_p": { "type": "number" }
        }
      }
    },
    "negative_control": {
      "type": "object",
      "required": ["description", "share_p_lt_0_05"],
      "properties": { "description": { "type": "string" }, "share_p_lt_0_05": { "type": "number" } }
    },
    "conclusion": {
      "type": "object",
      "required": ["random_rate_similar_to_published", "proliferation_adjustment_removes_most"],
      "properties": {
        "random_rate_similar_to_published": { "type": "boolean" },
        "proliferation_adjustment_removes_most": { "type": "boolean" }
      }
    },
    "extra": { "type": "object" }
  }
}
